# Contact form (app/acerca/actions.ts). Copy to .env.local and fill in.
# All three are read only on the server: never prefix them with NEXT_PUBLIC_.

# Resend API key (https://resend.com/api-keys). Required.
RESEND_API_KEY=

# Where contact messages are delivered. Required.
# While RESEND_FROM_EMAIL uses onboarding@resend.dev (no verified domain),
# Resend only delivers to the email address of your Resend account.
CONTACT_TO_EMAIL=

# Sender address. Optional; defaults to "Arcade Vault <onboarding@resend.dev>".
# Set it to an address on your verified domain once you have one.
RESEND_FROM_EMAIL=

# Supabase (lib/supabase/, app/api/health/route.ts).
# Both are PUBLIC by design: NEXT_PUBLIC_ inlines them into the browser bundle.
# Only ever put the publishable key here, never the secret key (sb_secret_...).

# Project URL, e.g. https://tooomjvkfhxfqgmjsctk.supabase.co. Required.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...), from Project Settings > API Keys. Required.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
